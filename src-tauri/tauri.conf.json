{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetMonitor",
  "version": "2.1.3",
  "identifier": "local.netmonitor.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NetMonitor",
        "width": 1180,
        "height": 940,
        "minWidth": 400,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0B0D10",
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NetMonitor",
    "shortDescription": "Monitor de red local en vivo",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
